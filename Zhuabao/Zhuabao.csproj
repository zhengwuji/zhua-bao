<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ZhuabaoCreater</AssemblyName>
    <RootNamespace>Zhuabao</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyTitle>抓包豆 Creator</AssemblyTitle>
    <Product>抓包豆 Creator</Product>
    <Version>1.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 发布优化：dotnet publish -r win-x64 时生效（单文件 + 压缩，显著减小体积） -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zhuabao.Core\Zhuabao.Core.csproj" />
  </ItemGroup>

</Project>
